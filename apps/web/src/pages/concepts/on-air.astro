---
// CONCEPT B: "On Air". The club as an always-on radio station.
// Refs: Refuge Worldwide / NTS (Next Up ticker, pill labels, tags), Watts
// (pill nav, wordmark bleeding off the hero), The Future in Black (figure
// bursting through the wordmark). Keeps the carbon background.
import { Image, getImage } from "astro:assets";
import Concept from "../../layouts/Concept.astro";
import logo from "../../assets/cougars.png";
import background from "../../assets/cougars_background.png";
import { getEvents, getSettings, upcoming } from "../../lib/sanity/content";
import { formatDayDate, formatTime } from "../../lib/dates";

const s = await getSettings();
const slot = s.training[0];
const events = upcoming(await getEvents());
const kumite = events.find((e) => e.type === "kumite");
const others = events.filter((e) => e !== kumite).slice(0, 3);
const bg = (await getImage({ src: background, width: 1800, format: "webp", quality: 70 })).src;
const tick = [
  `${slot?.day}s ${slot?.start}–${slot?.end}`,
  s.venue.name,
  kumite ? `Kumite · ${formatDayDate(kumite.startsAt)}` : "Kumite · date TBA",
  "All levels",
  ...(s.firstSessionKit ? ["Kit provided first visit"] : []),
  `Est. ${s.founded}`,
];
const tags = [
  "All levels",
  "Non-contact",
  ...(s.firstSessionKit ? ["Kit provided"] : []),
  "Multinational",
  "London SW11",
  `Since ${s.founded}`,
];
---

<Concept title="On Air" fonts={["--font-unbounded", "--font-mono"]}>
  <div class="page" style={`--bg:url(${bg})`}>
    <div class="ticker mono">
      <span class="tag" data-onair>
        Next up
      </span>
      <div class="track">
        {[0, 1].map(() => (
          <span>
            {tick.map((t) => (
              <i>{t}</i>
            ))}
          </span>
        ))}
      </div>
    </div>

    <nav class="pillnav mono" aria-label="Main">
      <a href="#" class="home">
        <Image src={logo} alt="Battersea Cougars" width={80} />
      </a>
      <a href="#">Fridays</a>
      <a href="#">Kumite</a>
      <a href="#">Events</a>
      <a href="#" class="hide-sm">
        Videos
      </a>
      <a href="#" class="hide-sm">
        Photos
      </a>
      <a href="#" class="join">
        Join
      </a>
    </nav>

    <section class="hero">
      <div class="meta mono">
        <span>Inline hockey · Battersea</span>
        <span>
          London <b data-clock>--:--</b>
        </span>
      </div>
      <Image class="cat" src={logo} alt="" width={900} loading="eager" />
      <h1 class="word" aria-label="Battersea Cougars">
        Cougars
      </h1>
    </section>

    <section class="schedule">
      <h2 class="label">Schedule</h2>
      <div class="rows">
        <a href="#" class="row">
          <span class="time mono">{slot?.start}</span>
          <span class="what">
            <strong>{slot?.title ?? "Friday session"}</strong>
            <span class="mono dim">
              Every {slot?.day} · {s.venue.name}
            </span>
          </span>
          <span class="chip mono">Weekly</span>
        </a>
        {others.map((e) => (
          <a href="#" class="row">
            <span class="time mono">{formatTime(e.startsAt)}</span>
            <span class="what">
              <strong>{e.title}</strong>
              <span class="mono dim">{formatDayDate(e.startsAt)}</span>
            </span>
            <span class="chip mono">{e.type}</span>
          </a>
        ))}
      </div>
      <ul class="tags mono">
        {tags.map((t) => (
          <li>{t}</li>
        ))}
      </ul>
    </section>

    <section class="kumite">
      <p class="mono">Special broadcast · Quarterly</p>
      <h2>Kumite</h2>
      <div class="k-foot">
        <p class="mono">{s.kumite.format.join(" / ")}</p>
        <p class="count">
          {kumite ? (
            <>
              <b data-days={kumite.startsAt}>—</b>
              <span class="mono">days to go</span>
            </>
          ) : (
            <span class="mono">Date TBA</span>
          )}
        </p>
      </div>
    </section>

    <div class="ticker ticker--foot mono">
      <div class="track reverse">
        {[0, 1].map(() => (
          <span>
            {tags.map((t) => (
              <i>{t}</i>
            ))}
          </span>
        ))}
      </div>
    </div>
  </div>
</Concept>

<script>
  const clock = document.querySelector<HTMLElement>("[data-clock]");
  const tag = document.querySelector<HTMLElement>("[data-onair]");
  const tickClock = () => {
    const now = new Date();
    const fmt = (o: Intl.DateTimeFormatOptions) => now.toLocaleString("en-GB", { timeZone: "Europe/London", ...o });
    if (clock) clock.textContent = fmt({ hour: "2-digit", minute: "2-digit" });
    const day = fmt({ weekday: "short" });
    const hm = Number(fmt({ hour: "2-digit", hour12: false })) * 60 + Number(fmt({ minute: "2-digit" }));
    if (tag) tag.textContent = day === "Fri" && hm >= 19 * 60 + 30 && hm < 21 * 60 + 30 ? "● On now" : "Next up";
  };
  tickClock();
  setInterval(tickClock, 15_000);
  document.querySelectorAll<HTMLElement>("[data-days]").forEach((el) => {
    el.textContent = String(Math.max(0, Math.ceil((Date.parse(el.dataset.days!) - Date.now()) / 86_400_000)));
  });
</script>

<style>
  :global(body) {
    --ink: #0a0a0a;
    --acid: #e4ff3a;
    --red: #d1333c;
    --bone: #f1efe9;
    background: var(--ink);
    color: var(--bone);
    font-family: var(--font-unbounded);
  }
  .page {
    position: relative;
    min-height: 100vh;
    background:
      linear-gradient(to bottom, rgb(10 10 10 / 0.2), rgb(10 10 10 / 0.85) 70%),
      var(--bg) center top / cover fixed;
  }
  .mono {
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }
  .dim {
    opacity: 0.6;
  }

  /* Ticker */
  .ticker {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    align-items: stretch;
    overflow: clip;
    background: var(--acid);
    color: var(--ink);
    font-size: 0.8rem;
    font-weight: 700;
    border-bottom: 2px solid var(--ink);
  }
  .tag {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    padding: 0.55rem 1rem;
    margin: 0.3rem;
    border: 2px solid var(--ink);
    border-radius: 999px;
    background: var(--acid);
    z-index: 1;
  }
  .track {
    display: flex;
    width: max-content;
    align-items: center;
    animation: marquee 32s linear infinite;
  }
  .track.reverse {
    animation-direction: reverse;
  }
  .track span {
    display: flex;
  }
  .track i {
    font-style: normal;
    white-space: nowrap;
    padding: 0.7rem 1.25rem;
  }
  .track i::after {
    content: "//";
    margin-left: 2.5rem;
    opacity: 0.5;
  }
  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }
  .ticker--foot {
    position: static;
    border-top: 2px solid var(--ink);
    background: var(--red);
    color: #fff;
  }

  /* Pill nav */
  .pillnav {
    position: sticky;
    top: 3.4rem;
    z-index: 19;
    display: flex;
    align-items: center;
    gap: 0.25rem;
    width: fit-content;
    margin: 1rem auto 0;
    padding: 0.35rem;
    border-radius: 999px;
    background: rgb(10 10 10 / 0.75);
    backdrop-filter: blur(10px);
    border: 1px solid rgb(241 239 233 / 0.15);
    font-size: 0.72rem;
  }
  .pillnav a {
    padding: 0.55rem 0.9rem;
    border-radius: 999px;
    transition: background 0.2s;
  }
  .pillnav a:hover {
    background: rgb(241 239 233 / 0.12);
  }
  .pillnav .home {
    padding: 0.2rem 0.6rem;
  }
  .pillnav .home :global(img) {
    width: 2.4rem;
  }
  .pillnav .join {
    background: var(--acid);
    color: var(--ink);
    font-weight: 700;
  }
  .pillnav .join:hover {
    background: #fff;
  }

  /* Hero: wordmark bleeds off the bottom, cougar bursts through */
  .hero {
    position: relative;
    display: grid;
    place-items: center;
    min-height: calc(100svh - 8rem);
    overflow: clip;
    padding-top: 2rem;
  }
  .meta {
    position: absolute;
    top: 1.5rem;
    left: clamp(1rem, 4vw, 3rem);
    right: clamp(1rem, 4vw, 3rem);
    display: flex;
    justify-content: space-between;
    font-size: 0.72rem;
  }
  .meta b {
    color: var(--acid);
  }
  .word {
    position: absolute;
    bottom: -0.16em;
    left: 50%;
    translate: -50% 0;
    margin: 0;
    font-size: clamp(4rem, 18.5vw, 20rem);
    font-weight: 900;
    line-height: 0.8;
    letter-spacing: -0.05em;
    text-transform: lowercase;
    white-space: nowrap;
    color: var(--bone);
    z-index: 1;
  }
  .hero :global(.cat) {
    position: relative;
    z-index: 2;
    width: min(62vw, 34rem);
    align-self: end;
    margin-bottom: 7.5vw;
    filter: drop-shadow(0 30px 50px rgb(0 0 0 / 0.6));
    animation: bob 6s ease-in-out infinite;
  }
  @keyframes bob {
    50% {
      transform: translateY(-10px) rotate(-1.5deg);
    }
  }

  /* Schedule */
  .schedule {
    position: relative;
    z-index: 3;
    max-width: 72rem;
    margin: 0 auto;
    padding: clamp(3rem, 8vw, 6rem) clamp(1rem, 4vw, 3rem);
    background: var(--ink);
  }
  .label {
    display: inline-block;
    margin: 0 0 1.5rem;
    padding: 0.5rem 1.1rem;
    border: 2px solid var(--bone);
    border-radius: 999px;
    font-size: 1rem;
    font-weight: 700;
  }
  .row {
    display: grid;
    grid-template-columns: 6rem 1fr auto;
    align-items: center;
    gap: 1.25rem;
    padding: 1.25rem 0;
    border-top: 1px solid rgb(241 239 233 / 0.18);
    transition: padding 0.25s;
  }
  .row:hover {
    padding-left: 0.75rem;
  }
  .row .time {
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--acid);
  }
  .what {
    display: grid;
    gap: 0.3rem;
  }
  .what strong {
    font-size: clamp(1.1rem, 2.4vw, 1.8rem);
    font-weight: 600;
    letter-spacing: -0.03em;
  }
  .what .mono {
    font-size: 0.72rem;
  }
  .chip {
    padding: 0.3rem 0.6rem;
    border: 1.5px solid rgb(241 239 233 / 0.4);
    border-radius: 999px;
    font-size: 0.65rem;
  }
  .tags {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    font-size: 0.7rem;
  }
  .tags li {
    padding: 0.35rem 0.7rem;
    border-radius: 999px;
    background: rgb(241 239 233 / 0.1);
  }

  /* Kumite: acid block */
  .kumite {
    position: relative;
    z-index: 3;
    padding: clamp(3rem, 8vw, 6rem) clamp(1rem, 4vw, 3rem);
    background: var(--acid);
    color: var(--ink);
  }
  .kumite > .mono {
    font-size: 0.8rem;
    font-weight: 700;
  }
  .kumite h2 {
    margin: 0.5rem 0 0;
    font-size: clamp(4.5rem, 20vw, 20rem);
    font-weight: 900;
    line-height: 0.8;
    letter-spacing: -0.06em;
    text-transform: lowercase;
  }
  .k-foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 1.5rem;
    margin-top: 2rem;
  }
  .k-foot > .mono {
    max-width: 30rem;
    font-size: 0.8rem;
    line-height: 1.6;
  }
  .count {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }
  .count b {
    font-size: clamp(3rem, 8vw, 6rem);
    font-weight: 900;
    letter-spacing: -0.05em;
    color: var(--red);
  }
  @media (max-width: 40rem) {
    .hide-sm {
      display: none;
    }
    .row {
      grid-template-columns: 4.5rem 1fr;
    }
    .chip {
      display: none;
    }
  }
</style>
