---
import Concept from "../../layouts/Concept.astro";

const concepts = [
  {
    href: "/concepts/programme/",
    name: "A · Programme",
    note: "Printed venue programme: ticket stub, Kumite as a named season.",
  },
  {
    href: "/concepts/on-air/",
    name: "B · On Air",
    note: "Always-on radio station: Next Up ticker, carbon, acid yellow.",
  },
  {
    href: "/concepts/ledger/",
    name: "C · Ledger",
    note: "Thirty years as an index: one cover, giant one-line entries.",
  },
];
---

<Concept title="Concepts" fonts={["--font-sans", "--font-mono"]}>
  <main>
    <p class="mono">Battersea Cougars · design concepts</p>
    <ul>
      {concepts.map((c) => (
        <li>
          <a href={c.href}>
            <strong>{c.name}</strong>
            <span class="mono">{c.note}</span>
          </a>
        </li>
      ))}
    </ul>
    <p class="mono">
      <a href="/">← Current site</a>
    </p>
  </main>
</Concept>

<style>
  :global(body) {
    background: #111;
    color: #eee;
    font-family: var(--font-sans);
  }
  main {
    max-width: 50rem;
    margin: 0 auto;
    padding: 4rem 1.5rem;
  }
  .mono {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    opacity: 0.7;
  }
  ul {
    list-style: none;
    margin: 2rem 0;
    padding: 0;
  }
  a {
    display: grid;
    gap: 0.4rem;
    padding: 1.5rem 0;
    border-bottom: 1px solid #333;
  }
  strong {
    font-size: 2.5rem;
    font-weight: 500;
    letter-spacing: -0.03em;
  }
  a:hover strong {
    color: #d1333c;
  }
</style>
