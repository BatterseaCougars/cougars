---
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";
import PostCard from "../../components/PostCard.astro";
import Empty from "../../components/Empty.astro";
import { getPosts, getSettings } from "../../lib/sanity/content";

const posts = await getPosts();
const s = await getSettings();
---

<Base title="News" description="News and announcements from the Battersea Cougars.">
  <PageHeader eyebrow="From the club" title="News" />
  <div class="wrap page-body">
    {posts.length ? (
      <div class="grid">
        {posts.map((p, i) => (
          <div data-reveal style={`--i:${i % 3}`}>
            <PostCard post={p} />
          </div>
        ))}
      </div>
    ) : (
      <Empty>
        No news yet. Follow us on{" "}
        <a href={s.socials.instagram ?? "#"} rel="noopener" target="_blank">
          Instagram
        </a>{" "}
        for the latest.
      </Empty>
    )}
  </div>
</Base>
