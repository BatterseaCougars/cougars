---
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";
import Empty from "../../components/Empty.astro";
import { getAlbums, getSettings } from "../../lib/sanity/content";
import { imageUrl, objectPosition } from "../../lib/sanity/images";
import { formatDate } from "../../lib/dates";

const albums = await getAlbums();
const s = await getSettings();
---

<Base title="Gallery" description="Photos from Cougars training, tournaments and socials.">
  <PageHeader eyebrow="On court" title="Gallery" />
  <div class="wrap page-body">
    {albums.length ? (
      <div class="grid">
        {albums.map((a) => (
          <a class="card album" href={`/gallery/${a.slug}/`}>
            <img
              src={imageUrl(a.cover, 640, 480)}
              alt=""
              loading="lazy"
              style={`object-position:${objectPosition(a.cover)}`}
            />
            <div class="meta">
              <h3>{a.title}</h3>
              <p class="muted">
                {formatDate(a.date)} · {a.photos.length} photos
              </p>
            </div>
          </a>
        ))}
      </div>
    ) : (
      <Empty title="No albums yet">
        See more on <a href={s.socials.instagram ?? "#"}>Instagram</a>.
      </Empty>
    )}
  </div>
</Base>

<style>
  .album {
    text-decoration: none;
    transition: border-color 0.15s;
  }
  .album:hover {
    border-color: var(--red);
    color: inherit;
  }
  img {
    aspect-ratio: 4 / 3;
    width: 100%;
    object-fit: cover;
  }
  .meta {
    padding: 0.9rem 1.15rem 0.25rem;
  }
  h3 {
    margin-bottom: 0.2rem;
  }
</style>
