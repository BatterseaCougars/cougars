---
import type { GetStaticPaths } from "astro";
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";
import { getAlbums } from "../../lib/sanity/content";
import { imageUrl, imageSrcSet } from "../../lib/sanity/images";
import { formatDate } from "../../lib/dates";
import type { Album } from "../../lib/sanity/types";

export const getStaticPaths = (async () =>
  (await getAlbums()).map((album) => ({ params: { slug: album.slug }, props: { album } }))) satisfies GetStaticPaths;

const { album } = Astro.props as { album: Album };
---

<Base title={album.title} image={imageUrl(album.cover, 1200, 630)}>
  <PageHeader eyebrow={formatDate(album.date)} title={album.title} />
  <div class="wrap page-body">
    <ul class="masonry">
      {album.photos.map((p) => (
        <li>
          <a href={imageUrl(p, 2000)} data-caption={p.caption ?? ""}>
            <img
              src={imageUrl(p, 600)}
              srcset={imageSrcSet(p, [400, 600, 900])}
              sizes="(max-width: 40rem) 50vw, 24rem"
              alt={p.alt ?? p.caption ?? ""}
              loading="lazy"
            />
          </a>
          {p.caption && <span class="cap">{p.caption}</span>}
        </li>
      ))}
    </ul>
    <p>
      <a href="/gallery/">← All albums</a>
    </p>
  </div>

  <dialog class="lightbox" aria-label="Photo viewer">
    <img alt="" />
    <p class="muted"></p>
    <button type="button" class="close" aria-label="Close">
      ×
    </button>
    <button type="button" class="nav prev" aria-label="Previous photo">
      ‹
    </button>
    <button type="button" class="nav next" aria-label="Next photo">
      ›
    </button>
  </dialog>
</Base>

<style>
  .masonry {
    list-style: none;
    margin: 0 0 2rem;
    padding: 0;
    columns: 3 18rem;
    column-gap: 0.75rem;
  }
  .masonry li {
    break-inside: avoid;
    margin-bottom: 0.75rem;
  }
  .masonry img {
    width: 100%;
    border-radius: 6px;
  }
  .cap {
    display: block;
    font-size: 0.875rem;
    color: var(--bone-2);
    padding-top: 0.3rem;
  }
  .lightbox {
    max-width: 100vw;
    max-height: 100dvh;
    width: 100vw;
    height: 100dvh;
    margin: 0;
    padding: 1rem;
    border: 0;
    background: rgb(0 0 0 / 0.94);
    color: var(--bone);
  }
  .lightbox[open] {
    display: grid;
    place-items: center;
    align-content: center;
    gap: 0.5rem;
  }
  .lightbox::backdrop {
    background: transparent;
  }
  .lightbox img {
    max-height: 85dvh;
    width: auto;
    border-radius: 4px;
  }
  .lightbox button {
    position: absolute;
    background: rgb(255 255 255 / 0.1);
    border: 0;
    color: #fff;
    font-size: 2rem;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    cursor: pointer;
  }
  .close {
    top: 1rem;
    right: 1rem;
  }
  .nav {
    top: 50%;
    translate: 0 -50%;
  }
  .prev {
    left: 1rem;
  }
  .next {
    right: 1rem;
  }
</style>

<script>
  // Progressive enhancement: links open full-size images without JS.
  const dialog = document.querySelector<HTMLDialogElement>(".lightbox")!;
  const links = [...document.querySelectorAll<HTMLAnchorElement>(".masonry a")];
  const img = dialog.querySelector("img")!;
  const caption = dialog.querySelector("p")!;
  let index = 0;

  const show = (i: number) => {
    index = (i + links.length) % links.length;
    const link = links[index];
    img.src = link.href;
    img.alt = link.querySelector("img")?.alt ?? "";
    caption.textContent = link.dataset.caption ?? "";
  };

  links.forEach((link, i) =>
    link.addEventListener("click", (e) => {
      e.preventDefault();
      show(i);
      dialog.showModal();
    }),
  );
  dialog.querySelector(".close")!.addEventListener("click", () => dialog.close());
  dialog.querySelector(".prev")!.addEventListener("click", () => show(index - 1));
  dialog.querySelector(".next")!.addEventListener("click", () => show(index + 1));
  dialog.addEventListener("click", (e) => e.target === dialog && dialog.close());
  dialog.addEventListener("keydown", (e) => {
    if (e.key === "ArrowLeft") show(index - 1);
    if (e.key === "ArrowRight") show(index + 1);
  });
</script>
