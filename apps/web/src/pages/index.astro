---
import { Image, getImage } from "astro:assets";
import Base from "../layouts/Base.astro";
import logo from "../assets/cougars.png";
import background from "../assets/cougars_background.png";
import { getAlbums, getEvents, getPlayers, getPosts, getSettings, getVideos, upcoming } from "../lib/sanity/content";
import { imageUrl, objectPosition } from "../lib/sanity/images";
import { formatDate } from "../lib/dates";
import EventList from "../components/EventList.astro";
import Empty from "../components/Empty.astro";
import KumitePoster from "../components/KumitePoster.astro";
import PlayerCard from "../components/PlayerCard.astro";
import PostCard from "../components/PostCard.astro";
import VideoCard from "../components/VideoCard.astro";

const s = await getSettings();
const all = upcoming(await getEvents());
const kumite = all.find((e) => e.type === "kumite");
const events = all.filter((e) => e !== kumite).slice(0, 4);
const slot = s.training[0];
const players = (await getPlayers()).slice(0, 5);
const videos = (await getVideos()).slice(0, 2);
const albums = (await getAlbums()).slice(0, 3);
const posts = (await getPosts()).slice(0, 3);
const day = slot?.day ?? "Friday";
// Quick facts under "Who we are"
const strip: [string, string][] = [
  [String(s.founded), "Founded"],
  [slot ? `${day}s ${slot.start}` : `${day}s`, "Club hockey"],
  ...(s.team.league ? ([[s.team.league, "League team"]] as [string, string][]) : []),
  ["The pub", "Afterwards"],
];
const heroBg = s.heroImage
  ? imageUrl(s.heroImage, 2000, 1200)
  : (await getImage({ src: background, width: 1800, format: "webp", quality: 72 })).src;
---

<Base>
  <section class="hero" id="top" data-hero style={`--hero-bg:url(${heroBg});--hero-pos:${objectPosition(s.heroImage)}`}>
    <div class="hero-bg" aria-hidden="true"></div>
    <h1 class="visually-hidden">Battersea Cougars inline hockey club</h1>
    <Image class="hero-logo" src={logo} alt="Battersea Cougars" width={640} loading="eager" fetchpriority="high" />
    <a class="scroll" href="#club" aria-label="Scroll to content">
      <span></span>
    </a>
  </section>

  <section class="section wrap club" id="club">
    <div data-reveal>
      <p class="kicker">Who we are</p>
      <h2>{s.heroHeadline}</h2>
    </div>
    <div data-reveal style="--i:1">
      {s.aboutBody.split(/\n{2,}/).map((para) => (
        <p class="lede">{para}</p>
      ))}
    </div>
    <dl class="strip">
      {strip.map(([value, label], i) => (
        <div data-reveal style={`--i:${i}`}>
          <dt class="label">{label}</dt>
          <dd>{value}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="section wrap fridays band" id="fridays">
    <div class="fridays-head">
      <div data-reveal>
        <p class="kicker">Every {day} · Regular club hockey</p>
        <h2>
          {day} night
          <br />
          hockey
        </h2>
      </div>
      {slot && (
        <p class="time num" data-reveal style="--i:1">
          {slot.start}
          <span class="dash">–</span>
          {slot.end}
        </p>
      )}
    </div>
    <div class="fridays-copy">
      <p class="lede" data-reveal style="--i:2">
        {slot?.description}
      </p>
      <dl class="facts" data-reveal style="--i:3">
        <div>
          <dt class="label">Where</dt>
          <dd>
            <a class="link" href={s.venue.mapUrl} rel="noopener" target="_blank">
              {s.venue.name} ↗
            </a>
            <span class="muted">{s.venue.address}</span>
          </dd>
        </div>
        <div>
          <dt class="label">Bring</dt>
          <dd>
            <span class="muted">{s.kitNotes}</span>
          </dd>
        </div>
        <div>
          <dt class="label">After</dt>
          <dd>
            <span>The pub.</span>
            <span class="muted">Most Fridays end with a pint at the local. Come for that too.</span>
          </dd>
        </div>
      </dl>
      <div class="actions" data-reveal style="--i:4">
        <a class="btn btn--primary" href="/join/">
          Try a session
        </a>
        <a class="label link" href="/fridays/">
          More about {day}s →
        </a>
      </div>
    </div>
  </section>

  <section class="section squad" id="team">
    <div class="wrap section-head row" data-reveal>
      <div>
        <p class="kicker">The official team{s.team.league && ` · ${s.team.league} league`}</p>
        <h2>Some characters</h2>
        <p class="lede intro">{s.team.intro}</p>
      </div>
      <a class="label link" href="/team/">
        Full roster →
      </a>
    </div>
    {players.length > 0 ? (
      <ul class="hand">
        {players.map((p, i) => (
          <li data-reveal style={`--i:${i};--tilt:${[-4, 2.5, -1.5, 3.5, -3][i % 5]}deg`}>
            <PlayerCard player={p} />
          </li>
        ))}
      </ul>
    ) : (
      <div class="wrap">
        <Empty>
          Roster coming soon. <a href="/team/">See the team page</a>.
        </Empty>
      </div>
    )}
  </section>

  <section id="kumite">
    <KumitePoster next={kumite} href="/kumite/" />
  </section>

  <section class="section wrap" id="events">
    <div class="section-head row" data-reveal>
      <div>
        <p class="kicker">Coming up</p>
        <h2>Also on the bill</h2>
        <p class="lede intro">Socials, clinics and tournaments, on top of every {day} on the rink.</p>
      </div>
      <a class="label link" href="/events/">
        All events
      </a>
    </div>
    {events.length ? (
      <EventList events={events} />
    ) : (
      <Empty>Nothing else on the calendar yet. Fridays never stop.</Empty>
    )}
  </section>

  <section class="section wrap band" id="media">
    <div class="section-head row" data-reveal>
      <div>
        <p class="kicker">Footage</p>
        <h2>Videos & photos</h2>
        <p class="lede intro">Friday nights and Kumite days, as filmed by whoever wasn't playing.</p>
      </div>
      <span class="see-all">
        <a class="label link" href="/videos/">
          All videos →
        </a>
        <a class="label link" href="/photos/">
          All photos →
        </a>
      </span>
    </div>
    {videos.length || albums.length ? (
      <div class="media-grid">
        {videos.length > 0 && (
          <div class="videos">
            {videos.map((v, i) => (
              <div data-reveal style={`--i:${i}`}>
                <VideoCard video={v} />
              </div>
            ))}
          </div>
        )}
        {albums.length > 0 && (
          <div class="albums">
            {albums.map((a, i) => (
              <a class="card album" href={`/photos/${a.slug}/`} data-reveal style={`--i:${i}`}>
                <div class="media">
                  <img
                    src={imageUrl(a.cover, 800, 600)}
                    alt=""
                    loading="lazy"
                    style={`object-position:${objectPosition(a.cover)}`}
                  />
                </div>
                <p class="label">
                  {formatDate(a.date)} · {a.photos.length} photos
                </p>
                <h3>{a.title}</h3>
              </a>
            ))}
          </div>
        )}
      </div>
    ) : (
      <Empty>
        Footage from Friday nights and the Kumite will appear here. Meanwhile, there's{" "}
        <a href={s.socials.instagram ?? "/photos/"} rel="noopener" target="_blank">
          Instagram
        </a>
        .
      </Empty>
    )}
  </section>

  <section class="section wrap" id="news">
    <div class="section-head row" data-reveal>
      <div>
        <p class="kicker">From the club</p>
        <h2>News</h2>
      </div>
      <a class="label link" href="/news/">
        All news →
      </a>
    </div>
    {posts.length ? (
      <div class="news-grid">
        {posts.map((p, i) => (
          <div data-reveal style={`--i:${i}`}>
            <PostCard post={p} />
          </div>
        ))}
      </div>
    ) : (
      <Empty>No news yet.</Empty>
    )}
  </section>
</Base>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    height: 100svh;
    min-height: 32rem;
    display: grid;
    place-items: center;
    overflow: clip;
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--hero-bg) var(--hero-pos) / cover no-repeat;
  }
  .hero-bg::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 60% 55% at 50% 50%, transparent, rgb(11 11 12 / 0.85)),
      linear-gradient(to top, var(--ink), transparent 35%);
  }
  .hero-bg::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 50% 50%, rgb(229 19 31 / 0.26), transparent 40%);
    pointer-events: none;
  }
  .hero :global(.hero-logo) {
    width: min(72vw, 32rem, 56svh);
    height: auto;
    filter: drop-shadow(0 30px 60px rgb(0 0 0 / 0.6));
  }
  .scroll {
    position: absolute;
    z-index: 3;
    bottom: 2.5rem;
    left: 50%;
    translate: -50% 0;
    padding: 1rem;
    color: var(--bone-3);
  }
  /* ark's bouncing chevron */
  .scroll span {
    display: block;
    width: 10px;
    height: 10px;
    border-right: 1px solid currentColor;
    border-bottom: 1px solid currentColor;
    transform: rotate(45deg);
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero :global(.hero-logo) {
      opacity: 0;
      animation: logo-in 1.6s var(--ease-smooth) 0.2s forwards;
    }
    .hero-bg {
      animation: settle 2.4s var(--ease-smooth) both;
    }
    .scroll span {
      animation: bounce 2s ease-in-out 1.6s infinite;
    }
    :global(html.navigation-restore) .hero :global(.hero-logo),
    :global(html.navigation-restore) .hero-bg {
      animation: none;
      opacity: 1;
    }
  }
  @keyframes logo-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes settle {
    from {
      opacity: 0;
      scale: 1.04;
    }
  }
  @keyframes bounce {
    0%,
    100% {
      transform: rotate(45deg) translate(0, 0);
      opacity: 1;
    }
    50% {
      transform: rotate(45deg) translate(3px, 3px);
      opacity: 0.4;
    }
  }

  .club {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 2rem clamp(3rem, 8vw, 7rem);
  }
  .club h2 {
    margin-top: 1rem;
  }
  @media (max-width: 52rem) {
    .club {
      grid-template-columns: 1fr;
    }
  }

  .fridays {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: start;
    gap: 2.5rem clamp(3rem, 7vw, 6rem);
  }
  .fridays h2 {
    margin-top: 1rem;
  }
  .fridays-head,
  .fridays-copy {
    display: grid;
    gap: 1.5rem;
  }
  .fridays-copy .lede {
    margin: 0;
  }
  .time {
    margin: 0;
    font-size: clamp(3rem, 6vw, 5rem);
    line-height: 1;
    color: var(--red-hot);
  }
  .time .dash {
    color: var(--bone-3);
    margin-inline: 0.08em;
  }
  .facts {
    margin: 0;
    border-top: 1px solid var(--line);
  }
  .facts > div {
    display: grid;
    grid-template-columns: 5rem 1fr;
    gap: 0.5rem 1.5rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--line);
  }
  .facts dd {
    margin: 0;
    display: grid;
    justify-items: start;
    gap: 0.2rem;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem 2.5rem;
  }
  /* A hand of cards, dealt slightly crooked. Scrolls sideways on small screens. */
  .squad {
    overflow-x: clip;
  }
  .hand {
    list-style: none;
    margin: 0;
    padding: 1.5rem var(--gutter) 2.5rem;
    display: flex;
    justify-content: safe center;
    gap: clamp(1rem, 2vw, 1.75rem);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .hand::-webkit-scrollbar {
    display: none;
  }
  .hand li {
    flex: 0 0 clamp(12rem, 15vw, 14rem);
    rotate: var(--tilt);
    scroll-snap-align: center;
    transition: rotate 0.5s var(--ease-smooth);
  }
  .hand li:hover,
  .hand li:focus-within {
    rotate: 0deg;
    z-index: 1;
  }
  .see-all {
    display: flex;
    gap: 1.5rem;
  }
  .media-grid {
    display: grid;
    gap: clamp(3rem, 6vw, 4.5rem);
  }
  .videos,
  .albums {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }
  .videos {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 26rem), 1fr));
  }
  .albums {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
  }
  .album img {
    aspect-ratio: 4 / 3;
    width: 100%;
    object-fit: cover;
  }
  .album .label {
    margin-top: 1.1rem;
  }
  .album h3 {
    margin-top: 0.5rem;
  }
  /* Alternate sections sit on a slightly lighter band so each reads as its own block */
  .band {
    background: var(--ink-2);
    box-shadow: 0 0 0 100vmax var(--ink-2);
    clip-path: inset(0 -100vmax);
  }
  .section-head .intro {
    margin: 1.25rem 0 0;
  }
  .news-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }
  .club .strip {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
    margin: clamp(1rem, 3vw, 2rem) 0 0;
    border-top: 1px solid var(--line);
  }
  .strip div {
    padding: 1.5rem 1.5rem 0 0;
  }
  .strip div + div {
    padding-left: 1.5rem;
    border-left: 1px solid var(--line);
  }
  .strip dd {
    margin: 0.6rem 0 0;
    font-family: var(--display);
    font-size: clamp(2rem, 3.6vw, 3rem);
    line-height: 1;
    text-transform: uppercase;
  }
  .strip div:first-child dd {
    color: var(--red-hot);
  }
  @media (max-width: 40rem) {
    .strip div + div {
      padding-left: 0;
      border-left: 0;
    }
  }
  .section-head.row {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }
  .section-head h2 {
    margin-top: 1rem;
  }
  @media (max-width: 56rem) {
    .fridays {
      grid-template-columns: 1fr;
    }
  }
</style>
