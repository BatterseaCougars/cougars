---
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";
import { getSettings } from "../../lib/sanity/content";

const s = await getSettings();
const slot = s.training[0];
---

<Base title="Thanks">
  <PageHeader
    eyebrow="Thanks"
    title="See you on court"
    lede={`We've got your details and someone from the club will be in touch soon.${slot ? ` Sessions are every ${slot.day}, ${slot.start}–${slot.end} at ${s.venue.name}.` : ""}`}
  >
    <a class="btn" href="/fridays/">
      About Fridays
    </a>
    <a class="label link" href="/">
      Home
    </a>
  </PageHeader>
</Base>
