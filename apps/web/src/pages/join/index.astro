---
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";
import { getSettings } from "../../lib/sanity/content";
import { EXPERIENCE } from "../../lib/server/enquiries";

const s = await getSettings();
const slot = s.training[0];
---

<Base
  title="Try a session"
  description="New to inline hockey? Kit is provided for your first session at Battersea Sports Centre."
>
  <PageHeader
    eyebrow="Join the Cougars"
    title="Try a session"
    lede="Whether you've never stood on skates or you've played for years, there's a place for you. Tell us a little about yourself and we'll be in touch."
  />
  <div class="wrap layout page-body">
    <form method="post" action="/api/join" class="card form" novalidate>
      <p class="alert" role="alert" tabindex="-1" hidden></p>
      <input type="hidden" name="source" value="/join/" />
      <div class="hp" aria-hidden="true">
        <label>
          Leave this empty <input name="website" tabindex="-1" autocomplete="off" />
        </label>
      </div>

      <label>
        <span>Your name *</span>
        <input name="name" required maxlength="100" autocomplete="name" />
        <small class="err" data-for="name"></small>
      </label>
      <label>
        <span>Email *</span>
        <input name="email" type="email" required maxlength="200" autocomplete="email" />
        <small class="err" data-for="email"></small>
      </label>
      <label>
        <span>
          Phone <em>(optional, for WhatsApp)</em>
        </span>
        <input name="phone" type="tel" maxlength="40" autocomplete="tel" />
      </label>
      <fieldset>
        <legend>Have you played before?</legend>
        {Object.entries(EXPERIENCE).map(([value, label]) => (
          <label class="choice">
            <input type="radio" name="experience" value={value} /> {label}
          </label>
        ))}
      </fieldset>
      <label>
        <span>
          Anything else? <em>(optional)</em>
        </span>
        <textarea name="message" rows="4" maxlength="2000"></textarea>
      </label>
      <button class="btn" type="submit">
        Send
      </button>
      <p class="muted small">We'll only use your details to get in touch about the club.</p>
    </form>

    <aside class="card info">
      <h3>The details</h3>
      {slot && (
        <p>
          <strong>
            {slot.day}s, {slot.start}–{slot.end}
          </strong>
          <br />
          <span class="muted">{slot.description}</span>
        </p>
      )}
      <p>
        <a href={s.venue.mapUrl} rel="noopener" target="_blank">
          {s.venue.name}
        </a>
        <br />
        <span class="muted">{s.venue.address}</span>
      </p>
      <p class="muted">{s.kitNotes}</p>
      <p>
        Prefer email? <a href={`mailto:${s.contactEmail}`}>{s.contactEmail}</a>
      </p>
    </aside>
  </div>
</Base>

<style>
  .layout {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 1.5rem;
    align-items: start;
  }
  @media (max-width: 48rem) {
    .layout {
      grid-template-columns: 1fr;
    }
  }
  .form,
  .info {
    padding: clamp(1.25rem, 4vw, 2rem);
  }
  .form {
    display: grid;
    gap: 1.1rem;
  }
  label > span,
  legend {
    display: block;
    font-weight: 600;
    margin-bottom: 0.35rem;
  }
  em {
    font-weight: 400;
    color: var(--bone-3);
    font-style: normal;
  }
  input:not([type="radio"]),
  textarea {
    width: 100%;
    padding: 0.75rem 0.9rem;
    font: inherit;
    color: var(--bone);
    background: var(--ink);
    border: 1px solid var(--line-strong);
    border-radius: 8px;
  }
  input:focus,
  textarea:focus {
    border-color: var(--red);
    outline: none;
    box-shadow: 0 0 0 3px rgb(209 51 60 / 0.3);
  }
  [aria-invalid="true"] {
    border-color: var(--red-hot) !important;
  }
  fieldset {
    border: 0;
    padding: 0;
    margin: 0;
  }
  .choice {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.35rem 0;
    cursor: pointer;
  }
  .choice input {
    accent-color: var(--red);
    width: 1.15rem;
    height: 1.15rem;
  }
  .err {
    color: var(--red-hot);
  }
  .alert {
    margin: 0;
    padding: 0.75rem 1rem;
    border-radius: 8px;
    background: rgb(209 51 60 / 0.15);
    border: 1px solid var(--red);
  }
  .btn {
    justify-self: start;
  }
  .small {
    font-size: 0.85rem;
    margin: 0;
  }
  .hp {
    position: absolute;
    left: -9999px;
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>("form.form")!;
  const alert = form.querySelector<HTMLElement>(".alert")!;
  const params = new URLSearchParams(location.search);
  const messages: Record<string, string> = {
    rate: "Too many submissions — please try again in a few minutes.",
    invalid: "Please check the form and try again.",
  };
  const showAlert = (msg: string) => {
    alert.textContent = msg;
    alert.hidden = false;
  };
  if (params.get("error")) showAlert(messages[params.get("error")!] ?? messages.invalid);

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    const button = form.querySelector<HTMLButtonElement>("button[type=submit]")!;
    button.disabled = true;
    form.querySelectorAll(".err").forEach((el) => (el.textContent = ""));
    form.querySelectorAll("[aria-invalid]").forEach((el) => el.removeAttribute("aria-invalid"));
    try {
      const res = await fetch(form.action, {
        method: "POST",
        body: new FormData(form),
        headers: { Accept: "application/json" },
      });
      const body = (await res.json()) as { ok: boolean; error?: string; errors?: Record<string, string> };
      if (body.ok) return location.assign("/join/thanks/");
      for (const [field, msg] of Object.entries(body.errors ?? {})) {
        form.querySelector(`.err[data-for="${field}"]`)!.textContent = msg;
        form.querySelector(`[name="${field}"]`)?.setAttribute("aria-invalid", "true");
      }
      showAlert(body.error ?? messages.invalid);
      (form.querySelector<HTMLElement>("[aria-invalid]") ?? alert).focus();
    } catch {
      showAlert("Something went wrong sending the form. Please try again or email us.");
    } finally {
      button.disabled = false;
    }
  });
</script>
