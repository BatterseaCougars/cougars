---
// One photo gallery: every album's photos on one page, newest album first.
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";
import Empty from "../../components/Empty.astro";
import Lightbox from "../../components/Lightbox.astro";
import { getAlbums, getSettings } from "../../lib/sanity/content";
import { imageSrcSet, imageUrl } from "../../lib/sanity/images";
import { formatDate } from "../../lib/dates";

const albums = await getAlbums();
const s = await getSettings();
const day = s.training[0]?.day ?? "Friday";
---

<Base title="Photos" description={`Photos from Cougars ${day} nights, the Kumite and the rest.`}>
  <PageHeader
    eyebrow="Photos"
    title="The evidence"
    lede={`Photographic proof that some of us can skate. ${day} nights, Kumite days and the rest; press one to see it big.`}
  />
  <div class="wrap page-body">
    {albums.length ? (
      albums.map((a) => (
        <section class="album" id={a.slug}>
          <header class="album-head" data-reveal>
            <h2>
              <a href={`/photos/${a.slug}/`}>{a.title}</a>
            </h2>
            <p class="label">
              {formatDate(a.date)} · {a.photos.length} photos
            </p>
          </header>
          <ul class="wall" data-gallery>
            {a.photos.map((p) => (
              <li>
                <a href={imageUrl(p, 2000)} data-photo data-caption={p.caption ?? ""}>
                  <img
                    src={imageUrl(p, 600)}
                    srcset={imageSrcSet(p, [400, 600, 900])}
                    sizes="(max-width: 40rem) 50vw, 20rem"
                    alt={p.alt ?? p.caption ?? ""}
                    loading="lazy"
                  />
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    ) : (
      <Empty>
        No photos yet. See more on{" "}
        <a href={s.socials.instagram ?? "#"} rel="noopener" target="_blank">
          Instagram
        </a>
        .
      </Empty>
    )}
  </div>
  <Lightbox />
</Base>

<style>
  .album + .album {
    margin-top: clamp(3.5rem, 8vw, 5.5rem);
  }
  .album-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    margin-bottom: 1.25rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--rule);
  }
  .album-head h2 {
    font-size: clamp(1.8rem, 3.5vw, 2.6rem);
  }
  .album-head a:hover {
    color: var(--red-hot);
  }
  .album-head .label {
    margin: 0;
  }
  .wall {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(46%, 13rem), 1fr));
    gap: 0.5rem;
  }
  .wall a {
    display: block;
    overflow: hidden;
  }
  .wall img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    transition:
      transform 0.6s var(--ease-out),
      filter 0.4s;
    filter: saturate(0.9);
  }
  .wall a:hover img {
    transform: scale(1.05);
    filter: none;
  }
</style>
