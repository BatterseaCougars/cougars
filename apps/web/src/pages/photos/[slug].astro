---
import type { GetStaticPaths } from "astro";
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";
import Lightbox from "../../components/Lightbox.astro";
import { getAlbums } from "../../lib/sanity/content";
import { imageUrl, imageSrcSet } from "../../lib/sanity/images";
import { formatDate } from "../../lib/dates";
import type { Album } from "../../lib/sanity/types";

export const getStaticPaths = (async () =>
  (await getAlbums()).map((album) => ({ params: { slug: album.slug }, props: { album } }))) satisfies GetStaticPaths;

const { album } = Astro.props as { album: Album };
---

<Base title={album.title} image={imageUrl(album.cover, 1200, 630)}>
  <PageHeader eyebrow={formatDate(album.date)} title={album.title} />
  <div class="wrap page-body">
    <ul class="masonry" data-gallery>
      {album.photos.map((p) => (
        <li>
          <a href={imageUrl(p, 2000)} data-photo data-caption={p.caption ?? ""}>
            <img
              src={imageUrl(p, 600)}
              srcset={imageSrcSet(p, [400, 600, 900])}
              sizes="(max-width: 40rem) 50vw, 24rem"
              alt={p.alt ?? p.caption ?? ""}
              loading="lazy"
            />
          </a>
          {p.caption && <span class="cap">{p.caption}</span>}
        </li>
      ))}
    </ul>
    <p>
      <a class="label link" href="/photos/">
        ← All photos
      </a>
    </p>
  </div>

  <Lightbox />
</Base>

<style>
  .masonry {
    list-style: none;
    margin: 0 0 2rem;
    padding: 0;
    columns: 3 18rem;
    column-gap: 0.75rem;
  }
  .masonry li {
    break-inside: avoid;
    margin-bottom: 0.75rem;
  }
  .masonry img {
    width: 100%;
    border-radius: 6px;
  }
  .cap {
    display: block;
    font-size: 0.875rem;
    color: var(--text-2);
    padding-top: 0.3rem;
  }
</style>
