---
import type { Post } from "../lib/sanity/types";
import { imageSrcSet, imageUrl, objectPosition } from "../lib/sanity/images";
import { formatDate } from "../lib/dates";

interface Props {
  post: Post;
}
const { post } = Astro.props;
const src = imageUrl(post.cover, 800, 600);
---

<a class="card post" href={`/news/${post.slug}/`}>
  <div class="media">
    {
      src ? (
        <img
          src={src}
          srcset={imageSrcSet(post.cover, [480, 800, 1200], 4 / 3)}
          sizes="(max-width: 40rem) 100vw, 28rem"
          alt={post.cover?.alt ?? ""}
          loading="lazy"
          style={`object-position:${objectPosition(post.cover)}`}
        />
      ) : (
        <div class="ph" aria-hidden="true">
          <span>{post.title.slice(0, 1)}</span>
        </div>
      )
    }
  </div>
  <div class="body">
    <p class="label label--plain">{formatDate(post.publishedAt)}</p>
    <h3>{post.title}</h3>
    {post.excerpt && <p class="muted">{post.excerpt}</p>}
  </div>
</a>

<style>
  .post {
    display: flex;
    flex-direction: column;
  }
  .media {
    overflow: clip;
  }
  img,
  .ph {
    aspect-ratio: 4 / 3;
    width: 100%;
    object-fit: cover;
  }
  .ph {
    display: grid;
    place-items: center;
    background: radial-gradient(circle at 30% 20%, rgb(209 51 60 / 0.35), transparent 60%), var(--ink-3);
    font-family: var(--display);
    font-weight: 900;
    font-size: 8rem;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--line-strong);
    text-transform: uppercase;
  }
  .body {
    padding: 1.25rem 1.5rem 1.5rem;
  }
  h3 {
    font-size: 2rem;
    line-height: 0.95;
    margin: 0.6rem 0 0.75rem;
  }
  .muted {
    margin: 0;
  }
</style>
