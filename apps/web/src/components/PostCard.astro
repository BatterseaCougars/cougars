---
import type { Post } from "../lib/sanity/types";
import { imageSrcSet, imageUrl, objectPosition } from "../lib/sanity/images";
import { formatDate } from "../lib/dates";

interface Props {
  post: Post;
}
const { post } = Astro.props;
const src = imageUrl(post.cover, 800, 600);
---

<a class="card post" href={`/news/${post.slug}/`}>
  {src && (
    <div class="media">
      <img
        src={src}
        srcset={imageSrcSet(post.cover, [480, 800, 1200], 4 / 3)}
        sizes="(max-width: 40rem) 100vw, 28rem"
        alt={post.cover?.alt ?? ""}
        loading="lazy"
        style={`object-position:${objectPosition(post.cover)}`}
      />
    </div>
  )}
  <p class="label">{formatDate(post.publishedAt)}</p>
  <h3>{post.title}</h3>
  {post.excerpt && <p class="muted">{post.excerpt}</p>}
</a>

<style>
  .post {
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
  }
  .media {
    margin-bottom: 1.25rem;
  }
  img {
    aspect-ratio: 4 / 3;
    width: 100%;
    object-fit: cover;
  }
  h3 {
    margin: 0.6rem 0 0.6rem;
  }
  .muted {
    margin: 0;
  }
</style>
