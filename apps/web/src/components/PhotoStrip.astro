---
// The home page's latest photos. The page is prerendered, so it first shows the photos from its last build
// (all a visitor without JavaScript gets), then swaps in the live ones from /api/photos/latest (ADR 0016).
// The Lightbox listens with a delegated handler, so swapped-in photos open in it too.
import Empty from "./Empty.astro";
import { imageSrcSet, imageUrl } from "../lib/sanity/images";
import type { Photo } from "../lib/sanity/types";

interface Props {
  photos: Photo[];
  /** Where the empty state points meanwhile. */
  instagram?: string | null;
}
const { photos, instagram } = Astro.props;
---

<div class="strip" data-photo-strip>
  {photos.length ? (
    <ul class="gallery" data-gallery data-reveal>
      {photos.map((p) => (
        <li>
          <a href={imageUrl(p, 2000)} data-photo data-caption={p.caption ?? ""}>
            <img
              src={imageUrl(p, 600)}
              srcset={imageSrcSet(p, [400, 600, 900])}
              sizes="(max-width: 40rem) 50vw, 18rem"
              alt={p.alt ?? ""}
              loading="lazy"
            />
          </a>
        </li>
      ))}
    </ul>
  ) : (
    <Empty>
      No photos yet. Meanwhile, there's{" "}
      <a href={instagram ?? "/photos/"} rel="noopener" target="_blank">
        Instagram
      </a>
      .
    </Empty>
  )}
</div>

<style>
  /* :global because the script rebuilds the list, and its elements don't carry Astro's scope attribute */
  .strip :global(.gallery) {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(46%, 11rem), 1fr));
    gap: 0.5rem;
  }
  .strip :global(.gallery li:first-child) {
    grid-column: span 2;
    grid-row: span 2;
  }
  .strip :global(.gallery a) {
    display: block;
    height: 100%;
    overflow: hidden;
  }
  .strip :global(.gallery img) {
    width: 100%;
    height: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    filter: saturate(0.9);
    transition:
      transform 0.6s var(--ease-out),
      filter 0.4s;
  }
  .strip :global(.gallery a:hover img) {
    transform: scale(1.05);
    filter: none;
  }
</style>

<script>
  import type { StripPhoto } from "../pages/api/photos/latest";

  function item(p: StripPhoto): HTMLLIElement {
    const li = document.createElement("li");
    const a = Object.assign(document.createElement("a"), { href: p.full });
    a.dataset.photo = "";
    a.dataset.caption = p.caption;
    const img = Object.assign(document.createElement("img"), { src: p.src, srcset: p.srcset, alt: p.alt });
    img.sizes = "(max-width: 40rem) 50vw, 18rem";
    img.loading = "lazy";
    a.appendChild(img);
    li.appendChild(a);
    return li;
  }

  async function refresh() {
    const strip = document.querySelector<HTMLElement>("[data-photo-strip]");
    if (!strip) return;
    let photos: StripPhoto[];
    try {
      const res = await fetch("/api/photos/latest", { headers: { Accept: "application/json" } });
      if (!res.ok) return;
      ({ photos } = (await res.json()) as { photos: StripPhoto[] });
    } catch {
      return; // offline or blocked: the build-time photos stay
    }
    if (!photos.length || !strip.isConnected) return;
    const shown = [...strip.querySelectorAll<HTMLAnchorElement>("a[data-photo]")].map((a) => a.href);
    if (shown.join() === photos.map((p) => new URL(p.full, location.href).href).join()) return;

    let list = strip.querySelector<HTMLUListElement>("ul[data-gallery]");
    if (!list) {
      // There were no photos at build time: the empty state makes way for a list
      list = Object.assign(document.createElement("ul"), { className: "gallery" });
      list.dataset.gallery = "";
      strip.replaceChildren(list);
    }
    list.replaceChildren(...photos.map(item));
  }

  document.addEventListener("astro:page-load", refresh);
</script>
