---
// Inline hockey rink markings (roughly 60 × 30 m, 2:1) as a line drawing.
// Every stroke has pathLength=1 so CSS can "draw" it in with stroke-dashoffset.
interface Props {
  class?: string;
  /** Animate the lines drawing in on load. */
  draw?: boolean;
}
const { class: className, draw = true } = Astro.props;

const W = 600;
const H = 300;
const faceoffs = [
  [140, 85],
  [140, 215],
  [460, 85],
  [460, 215],
];
---

<svg class:list={["rink", className, { draw }]} viewBox={`-4 -4 ${W + 8} ${H + 8}`} fill="none" aria-hidden="true">
  <rect x="0" y="0" width={W} height={H} rx="56" pathLength="1" />
  <line x1={W / 2} y1="0" x2={W / 2} y2={H} pathLength="1" class="red" />
  <circle cx={W / 2} cy={H / 2} r="45" pathLength="1" />
  <circle cx={W / 2} cy={H / 2} r="3" class="dot" />
  <line x1="60" y1="8" x2="60" y2={H - 8} pathLength="1" />
  <line x1={W - 60} y1="8" x2={W - 60} y2={H - 8} pathLength="1" />
  <path d={`M60 ${H / 2 - 28} a28 28 0 0 1 0 56`} pathLength="1" />
  <path d={`M${W - 60} ${H / 2 - 28} a28 28 0 0 0 0 56`} pathLength="1" />
  {
    faceoffs.map(([x, y]) => (
      <>
        <circle cx={x} cy={y} r="30" pathLength="1" />
        <circle cx={x} cy={y} r="3" class="dot" />
      </>
    ))
  }
</svg>

<style>
  .rink {
    stroke: var(--rink-stroke, rgb(209 51 60 / 0.35));
    stroke-width: var(--rink-width, 1.25);
    vector-effect: non-scaling-stroke;
  }
  .rink :where(rect, line, circle, path) {
    vector-effect: non-scaling-stroke;
  }
  .rink .red {
    stroke: var(--rink-accent, rgb(209 51 60 / 0.7));
  }
  .rink .dot {
    fill: var(--rink-accent, rgb(209 51 60 / 0.7));
    stroke: none;
  }
  .draw :where(rect, line, circle:not(.dot), path) {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: draw 2.4s var(--ease-out) forwards;
  }
  .draw :nth-child(2) {
    animation-delay: 0.15s;
  }
  .draw :nth-child(3) {
    animation-delay: 0.3s;
  }
  .draw :nth-child(n + 5) {
    animation-delay: 0.5s;
  }
  .draw .dot {
    opacity: 0;
    animation: fade 0.6s 1.4s forwards;
  }
  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes fade {
    to {
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .draw :where(rect, line, circle, path),
    .draw .dot {
      animation: none;
      stroke-dashoffset: 0;
      opacity: 1;
    }
  }
</style>
