---
const links = [
  { href: "/fridays/", label: "Fridays" },
  { href: "/kumite/", label: "Kumite" },
  { href: "/events/", label: "Events" },
  { href: "/videos/", label: "Videos" },
  { href: "/photos/", label: "Photos" },
  { href: "/news/", label: "News" },
];
const path = Astro.url.pathname;
const current = (href: string) => (path.startsWith(href) ? "page" : undefined);
---

<header class="header" data-header transition:name="site-header">
  <div class="bar">
    <a href="/" class="brand">
      Battersea Cougars
    </a>

    <nav class="nav" aria-label="Main">
      <ul>
        {links.map((l) => (
          <li>
            <a class="link" href={l.href} aria-current={current(l.href)}>
              {l.label}
            </a>
          </li>
        ))}
      </ul>
      <a class="btn btn--primary join" href="/join/" aria-current={current("/join/")}>
        Join
      </a>
    </nav>

    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="menu" data-menu-btn>
      <span class="visually-hidden">Menu</span>
      <span class="icon" aria-hidden="true"></span>
    </button>
  </div>
</header>

<!-- Outside <header>: its backdrop-filter would otherwise trap this fixed overlay inside the bar. -->
<div class="menu" id="menu" data-menu hidden>
  <ul>
    <li style="--i:0">
      <a href="/">Home</a>
    </li>
    {links.map((l, i) => (
      <li style={`--i:${i + 1}`}>
        <a href={l.href} aria-current={current(l.href)}>
          {l.label}
        </a>
      </li>
    ))}
    <li style={`--i:${links.length + 1}`}>
      <a href="/join/" aria-current={current("/join/")}>
        Join
      </a>
    </li>
  </ul>
</div>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 150;
    border-bottom: 1px solid transparent;
    background: linear-gradient(to bottom, rgb(11 11 12 / 0.6), transparent);
    transition:
      background 0.3s ease,
      border-color 0.3s ease;
  }
  :global(.header.is-scrolled) {
    background: rgb(11 11 12 / 0.82);
    backdrop-filter: blur(14px);
    border-color: var(--line);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-h);
    padding-inline: var(--gutter);
  }
  .brand {
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    font-size: 1.15rem;
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .nav {
    display: flex;
    align-items: center;
    gap: 2.5rem;
  }
  .nav .join {
    padding: 0.7rem 1.2rem;
  }
  .nav ul {
    display: flex;
    gap: 2.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav ul a {
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--bone-2);
  }
  .nav ul a:hover,
  .nav ul a[aria-current="page"] {
    color: var(--bone);
  }

  /* Hamburger → X (from ark) */
  .menu-btn {
    display: none;
    position: relative;
    z-index: 2;
    width: 2.75rem;
    height: 2.75rem;
    border: 0;
    background: transparent;
    color: var(--bone);
    cursor: pointer;
  }
  .icon {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 1.4rem;
    height: 8px;
    translate: -50% -50%;
  }
  .icon::before,
  .icon::after {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 1px;
    background: currentColor;
    transition: transform 0.35s var(--ease-out);
  }
  .icon::after {
    transform: translate3d(0, 7px, 0);
  }
  [aria-expanded="true"] .icon::before {
    transform: translate3d(0, 3.5px, 0) rotate(45deg);
  }
  [aria-expanded="true"] .icon::after {
    transform: translate3d(0, 3.5px, 0) rotate(-45deg);
  }

  .menu {
    position: fixed;
    inset: 0;
    z-index: 149;
    display: grid;
    place-items: center;
    background: rgb(11 11 12 / 0.92);
    backdrop-filter: blur(18px);
    opacity: 0;
    transition: opacity 0.4s var(--ease-out);
  }
  .menu.is-open {
    opacity: 1;
  }
  .menu ul {
    list-style: none;
    margin: 0;
    padding: 0;
    text-align: center;
  }
  .menu a {
    display: block;
    padding: 0.35rem 0;
    font-size: 2.6rem;
    font-weight: 400;
    letter-spacing: -0.02em;
    opacity: 0;
    transform: translateY(10px);
    transition:
      opacity 0.35s var(--ease-smooth) calc(var(--i) * 40ms + 100ms),
      transform 0.35s var(--ease-smooth) calc(var(--i) * 40ms + 100ms);
  }
  .menu.is-open a {
    opacity: 1;
    transform: none;
  }
  .menu a[aria-current="page"] {
    color: var(--bone-3);
  }

  @media (max-width: 60rem) {
    .nav {
      display: none;
    }
    .menu-btn {
      display: block;
    }
  }
</style>

<script>
  let abort: AbortController | undefined;
  function initMenu() {
    abort?.abort();
    abort = new AbortController();
    const { signal } = abort;
    document.body.style.overflow = "";
    const btn = document.querySelector<HTMLButtonElement>("[data-menu-btn]");
    const menu = document.querySelector<HTMLElement>("[data-menu]");
    if (!btn || !menu) return;
    const set = (open: boolean) => {
      btn.setAttribute("aria-expanded", String(open));
      document.body.style.overflow = open ? "hidden" : "";
      if (open) {
        menu.hidden = false;
        requestAnimationFrame(() => menu.classList.add("is-open"));
      } else {
        menu.classList.remove("is-open");
        setTimeout(() => (menu.hidden = btn.getAttribute("aria-expanded") === "false"), 400);
      }
    };
    btn.addEventListener("click", () => set(btn.getAttribute("aria-expanded") !== "true"));
    menu.addEventListener("click", (e) => (e.target as Element).closest("a") && set(false));
    document.addEventListener("keydown", (e) => e.key === "Escape" && set(false), { signal });
  }
  document.addEventListener("astro:page-load", initMenu);
</script>
