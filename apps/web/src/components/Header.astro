---
import { Image } from "astro:assets";
import logo from "../assets/cougars.png";

// One-page navigation: every item is a section of the home page, in page order. From any
// other page the link goes back to that section. Full pages (/fridays/, /team/, ...) are
// reached from the "see all" link inside each section.
const path = Astro.url.pathname;
const home = path === "/";
const links = [
  { section: "fridays", label: "Fridays", page: "/fridays/" },
  { section: "team", label: "Team", page: "/team/" },
  { section: "kumite", label: "Kumite", page: "/kumite/" },
  { section: "events", label: "Events", page: "/events/" },
  { section: "media", label: "Videos & photos", page: "/videos/" },
  { section: "news", label: "News", page: "/news/" },
].map((l) => ({ ...l, href: home ? `#${l.section}` : `/#${l.section}` }));
// On a full page, mark the section it belongs to (/photos/ belongs to "Videos & photos").
const owner = (l: (typeof links)[number]) =>
  path.startsWith(l.page) || (l.section === "media" && path.startsWith("/photos/"));
const current = (l: (typeof links)[number]) => (!home && owner(l) ? "page" : undefined);
---

<header class="header" data-header transition:name="site-header">
  <div class="bar">
    <a href="/" class="brand" aria-label="Battersea Cougars, home">
      <Image src={logo} alt="" width={120} class="brand-mark" loading="eager" />
      <span class="brand-text" aria-hidden="true">
        <span>Inline hockey</span>
        <span>Battersea · Est. 1996</span>
      </span>
    </a>

    <nav class="nav" aria-label="Main">
      <ul>
        {links.map((l) => (
          <li>
            <a class="link" href={l.href} aria-current={current(l)} data-section-link={l.section}>
              {l.label}
            </a>
          </li>
        ))}
      </ul>
      <a class="btn btn--primary join" href="/join/" aria-current={path.startsWith("/join/") ? "page" : undefined}>
        Join
      </a>
    </nav>

    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="menu" data-menu-btn>
      <span class="visually-hidden">Menu</span>
      <span class="icon" aria-hidden="true"></span>
    </button>
  </div>
</header>

<!-- Outside <header>: its backdrop-filter would otherwise trap this fixed overlay inside the bar. -->
<div class="menu" id="menu" data-menu hidden>
  <ul>
    <li style="--i:0">
      <a href={home ? "#top" : "/"}>Home</a>
    </li>
    {links.map((l, i) => (
      <li style={`--i:${i + 1}`}>
        <a href={l.href} aria-current={current(l)}>
          {l.label}
        </a>
      </li>
    ))}
    <li style={`--i:${links.length + 1}`}>
      <a href="/join/" aria-current={path.startsWith("/join/") ? "page" : undefined}>
        Join
      </a>
    </li>
  </ul>
</div>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 150;
    border-bottom: 1px solid transparent;
    background: linear-gradient(to bottom, rgb(11 11 12 / 0.6), transparent);
    transition:
      background 0.3s ease,
      border-color 0.3s ease;
  }
  :global(.header.is-scrolled) {
    background: rgb(11 11 12 / 0.82);
    backdrop-filter: blur(14px);
    border-color: var(--line);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-h);
    padding-inline: var(--gutter);
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }
  .brand :global(.brand-mark) {
    width: 3.75rem;
    transition: transform 0.4s var(--ease-smooth);
  }
  .brand:hover :global(.brand-mark) {
    transform: rotate(-4deg) scale(1.06);
  }
  .brand-text {
    display: grid;
    gap: 0.3rem;
    padding-left: 0.9rem;
    border-left: 1px solid var(--line-strong);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    line-height: 1;
    text-transform: uppercase;
    color: var(--bone-2);
  }
  .brand-text span:first-child {
    color: var(--bone);
  }
  .nav {
    display: flex;
    align-items: center;
    gap: 2.5rem;
  }
  .nav .join {
    padding: 0.7rem 1.2rem;
  }
  .nav ul {
    display: flex;
    gap: 2.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav ul a {
    font-family: var(--display);
    font-size: 1.05rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--bone-2);
  }
  .nav ul a:hover,
  .nav ul a[aria-current="page"] {
    color: var(--bone);
  }

  /* Hamburger → X (from ark) */
  .menu-btn {
    display: none;
    position: relative;
    z-index: 2;
    width: 2.75rem;
    height: 2.75rem;
    border: 0;
    background: transparent;
    color: var(--bone);
    cursor: pointer;
  }
  .icon {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 1.4rem;
    height: 8px;
    translate: -50% -50%;
  }
  .icon::before,
  .icon::after {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 1px;
    background: currentColor;
    transition: transform 0.35s var(--ease-out);
  }
  .icon::after {
    transform: translate3d(0, 7px, 0);
  }
  [aria-expanded="true"] .icon::before {
    transform: translate3d(0, 3.5px, 0) rotate(45deg);
  }
  [aria-expanded="true"] .icon::after {
    transform: translate3d(0, 3.5px, 0) rotate(-45deg);
  }

  .menu {
    position: fixed;
    inset: 0;
    z-index: 149;
    display: grid;
    place-items: center;
    background: rgb(11 11 12 / 0.92);
    backdrop-filter: blur(18px);
    opacity: 0;
    transition: opacity 0.4s var(--ease-out);
  }
  /* display: grid above would otherwise override [hidden] and leave an invisible overlay on the page */
  .menu[hidden] {
    display: none;
  }
  .menu.is-open {
    opacity: 1;
  }
  .menu ul {
    list-style: none;
    margin: 0;
    padding: 0;
    text-align: center;
  }
  .menu a {
    display: block;
    padding: 0.3rem 0;
    font-family: var(--display);
    font-size: 2.6rem;
    font-weight: 400;
    letter-spacing: 0.02em;
    line-height: 1.1;
    text-transform: uppercase;
    opacity: 0;
    transform: translateY(10px);
    transition:
      opacity 0.35s var(--ease-smooth) calc(var(--i) * 40ms + 100ms),
      transform 0.35s var(--ease-smooth) calc(var(--i) * 40ms + 100ms);
  }
  .menu.is-open a {
    opacity: 1;
    transform: none;
  }
  .menu a[aria-current="page"] {
    color: var(--bone-3);
  }

  @media (max-width: 60rem) {
    .nav {
      display: none;
    }
    .menu-btn {
      display: block;
    }
  }
</style>

<script>
  let abort: AbortController | undefined;
  function initMenu() {
    abort?.abort();
    abort = new AbortController();
    const { signal } = abort;
    document.body.style.overflow = "";
    const btn = document.querySelector<HTMLButtonElement>("[data-menu-btn]");
    const menu = document.querySelector<HTMLElement>("[data-menu]");
    if (!btn || !menu) return;
    const set = (open: boolean) => {
      btn.setAttribute("aria-expanded", String(open));
      document.body.style.overflow = open ? "hidden" : "";
      if (open) {
        menu.hidden = false;
        requestAnimationFrame(() => menu.classList.add("is-open"));
      } else {
        menu.classList.remove("is-open");
        setTimeout(() => (menu.hidden = btn.getAttribute("aria-expanded") === "false"), 400);
      }
    };
    btn.addEventListener("click", () => set(btn.getAttribute("aria-expanded") !== "true"));
    menu.addEventListener("click", (e) => (e.target as Element).closest("a") && set(false));
    document.addEventListener("keydown", (e) => e.key === "Escape" && set(false), { signal });
  }
  document.addEventListener("astro:page-load", initMenu);
</script>
