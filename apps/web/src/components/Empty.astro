---
// Quiet empty state, shown until the club adds content in the Studio.
---

<p class="empty muted" data-reveal>
  <slot />
</p>

<style>
  .empty {
    padding: 2.5rem 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    margin: 0;
  }
  .empty :global(a) {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--rule-strong);
    text-underline-offset: 0.25em;
  }
</style>
