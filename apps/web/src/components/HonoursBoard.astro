---
// Kumite champions, newest first: a plain results list.
import type { Honour } from "../lib/sanity/types";

interface Props {
  honours: Honour[];
}
const { honours } = Astro.props;
---

<figure class="board" data-reveal>
  <figcaption class="label">Kumite champions</figcaption>
  <ol>
    {honours.map((h) => (
      <li>
        <span class="season label">{h.season}</span>
        <span class="team">{h.champions ?? "—"}</span>
        {h.topScorer && <span class="scorer muted">Top scorer: {h.topScorer}</span>}
      </li>
    ))}
  </ol>
</figure>

<style>
  .board {
    margin: 0;
  }
  figcaption {
    margin-bottom: 1rem;
  }
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }
  li {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: 0.2rem 1.25rem;
    align-items: baseline;
    padding: 1rem 0;
    border-bottom: 1px solid var(--rule);
  }
  .season {
    color: var(--text-2);
  }
  .team {
    font-family: var(--display);
    font-size: clamp(1.4rem, 2.6vw, 1.9rem);
    letter-spacing: 0.02em;
    line-height: 1.05;
    text-transform: uppercase;
  }
  .scorer {
    grid-column: 2;
    font-size: 0.85rem;
  }
  @media (max-width: 30rem) {
    li {
      grid-template-columns: 1fr;
    }
    .scorer {
      grid-column: 1;
    }
  }
</style>
