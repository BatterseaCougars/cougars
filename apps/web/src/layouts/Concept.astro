---
// Bare layout for design-concept prototypes: no site chrome or global styles,
// so each concept owns its whole look.
import { Font } from "astro:assets";

interface Props {
  title: string;
  fonts: ("--font-sans" | "--font-bricolage" | "--font-unbounded" | "--font-mono")[];
}
const { title, fonts } = Astro.props;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex" />
    <title>{title} · Concept · Battersea Cougars</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    {fonts.map((f) => (
      <Font cssVariable={f} preload />
    ))}
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  html {
    -webkit-text-size-adjust: 100%;
    -webkit-font-smoothing: antialiased;
    overflow-x: clip;
  }
  body {
    margin: 0;
  }
  img {
    max-width: 100%;
    height: auto;
    display: block;
  }
  a {
    color: inherit;
    text-decoration: none;
  }
  p {
    margin: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation: none !important;
      transition: none !important;
    }
  }
</style>
