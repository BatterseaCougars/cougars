# Repo-root .env: LOCAL, NON-SECRET overrides only (docs/adr/0002-secrets-in-bitwarden.md).
# Secrets never go here: they load from Bitwarden at run time
#   node scripts/env-pull.mjs -- npm run dev
# Every secret and setting is documented in README.md#secrets.

# Preview the design with sample events, players, videos and photos.
# DEMO_CONTENT=true

# Read a different Sanity dataset locally (not secret).
# SANITY_DATASET=production
